{
  "name": "qoder-vscode-bridge",
  "displayName": "Qoder Model Provider for Copilot Chat",
  "description": "Use Qoder Agent SDK models from VS Code's native Chat model picker.",
  "version": "0.0.13",
  "publisher": "qianxunslimg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qianxunslimg/qoder-vscode-bridge"
  },
  "engines": {
    "vscode": ">=1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "qoder",
    "copilot",
    "language-model",
    "agent"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:qoderBridge.setPat",
    "onCommand:qoderBridge.clearPat",
    "onCommand:qoderBridge.refreshModels",
    "onCommand:qoderBridge.showUsage"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "qoder",
        "displayName": "Qoder",
        "managementCommand": "qoderBridge.setPat"
      }
    ],
    "languageModelTools": [
      {
        "name": "qoder_read_file",
        "displayName": "Qoder Read File",
        "modelDescription": "Read a UTF-8 text file inside the current VS Code workspace. This is a read-only bridge tool used by Qoder models for inspection; it must not be used for edits, shell commands, or files outside the workspace.",
        "userDescription": "Read a workspace file for Qoder",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "qoderReadFile",
        "icon": "$(file-code)",
        "tags": [
          "qoder",
          "read-only",
          "workspace"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "file_path": {
              "type": "string",
              "description": "Absolute path of a UTF-8 file inside the current workspace."
            },
            "offset": {
              "type": "number",
              "minimum": 0,
              "description": "Optional zero-based starting line."
            },
            "limit": {
              "type": "number",
              "minimum": 1,
              "maximum": 2000,
              "description": "Optional maximum number of lines to return."
            }
          },
          "required": [
            "file_path"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "qoderBridge.setPat",
        "title": "Qoder: Set Personal Access Token",
        "category": "Qoder"
      },
      {
        "command": "qoderBridge.clearPat",
        "title": "Qoder: Clear Personal Access Token",
        "category": "Qoder"
      },
      {
        "command": "qoderBridge.refreshModels",
        "title": "Qoder: Refresh Model Catalog",
        "category": "Qoder"
      },
      {
        "command": "qoderBridge.showUsage",
        "title": "Qoder: Show Usage",
        "category": "Qoder"
      }
    ],
    "configuration": {
      "title": "Qoder Bridge",
      "properties": {
        "qoderBridge.permissionMode": {
          "type": "string",
          "enum": [
            "auto",
            "acceptEdits",
            "default",
            "plan",
            "bypassPermissions",
            "yolo",
            "dontAsk"
          ],
          "default": "bypassPermissions",
          "description": "Qoder tool permission mode used by the model provider. The default skips Qoder-side approval; VS Code host-tool confirmation remains controlled by the host."
        },
        "qoderBridge.maxTurns": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 30,
          "description": "Maximum Qoder tool-loop turns for one Chat request."
        },
        "qoderBridge.includePartialMessages": {
          "type": "boolean",
          "default": true,
          "description": "Stream Qoder text deltas into Copilot Chat when available."
        },
        "qoderBridge.showActivity": {
          "type": "boolean",
          "default": true,
          "description": "Show Qoder plan, progress, tool results, task, and retry activity in Copilot Chat. Raw hidden reasoning is never displayed."
        },
        "qoderBridge.nativeToolLoop": {
          "type": "boolean",
          "default": true,
          "description": "Delegate tools supplied by Copilot Chat to VS Code's native tool loop. Requests without host tools keep Qoder's internal text-only path."
        },
        "qoderBridge.maxNativeTools": {
          "type": "number",
          "minimum": 8,
          "maximum": 128,
          "default": 91,
          "description": "Maximum number of VS Code host tools exposed to one Qoder request. The default preserves the host's complete current tool set; lower values keep core coding tools first."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "npm run compile",
    "test": "npm run compile && node --test test/*.test.mjs",
    "smoke": "node ./scripts/smoke.mjs",
    "catalog:smoke": "node ./scripts/catalog-smoke.mjs",
    "model:smoke": "node ./scripts/model-smoke.mjs",
    "native:smoke": "node --require ./scripts/vscode-mock-require.cjs ./scripts/native-tool-loop-smoke.mjs",
    "provider:native:smoke": "node --require ./scripts/vscode-mock-require.cjs ./scripts/provider-native-loop-smoke.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.19",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "1.106.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.2"
  }
}
